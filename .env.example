NODE_ENV=development
LOG_LEVEL=info

# Postgres (required, no default — never commit real credentials)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/indexer

# Redis (optional — cache-aside only; every read path degrades to Postgres if this is unset
# or unreachable, so it's fine to leave blank for a minimal local run)
REDIS_URL=redis://localhost:6379

# Chain / RPC (required, no default). CHAIN_ID must match what RPC_URL actually serves — the
# indexer verifies this at startup and refuses to run on a mismatch.
RPC_URL=https://eth.llamarpc.com
CHAIN_ID=1

# The single contract the indexer watches (required, no default). eth_getLogs is scoped to this
# address only — never the whole chain.
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Indexer tuning (sensible defaults apply if omitted)
INDEXER_START_BLOCK=0
INDEXER_CHUNK_SIZE=2000
INDEXER_POLL_INTERVAL_MS=4000
CONFIRMATIONS=5

# API
API_PORT=3000
