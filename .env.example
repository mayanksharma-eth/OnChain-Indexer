NODE_ENV=development
LOG_LEVEL=info

# Postgres (required, no default — never commit real credentials)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/onchain_indexer

# Redis (required, no default)
REDIS_URL=redis://localhost:6379

# Chain / RPC (required, no default)
RPC_URL=https://eth.llamarpc.com
CHAIN_ID=31337

# Indexer tuning (sensible defaults apply if omitted)
INDEXER_START_BLOCK=0
INDEXER_CHUNK_SIZE=2000
INDEXER_POLL_INTERVAL_MS=4000
CONFIRMATIONS=5

# API
API_PORT=3000
